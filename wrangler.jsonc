{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-bfn-tr",
  "compatibility_date": "2026-07-30",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  }
}

---
import { SITE } from "@config";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer
  class={`site-footer border-t border-skin-line ${noMarginTop ? "" : "mt-auto"}`}
>
  <div class="footer-inner">
    <span>&#169; {currentYear} {SITE.author}</span>
    <div class="spacer"></div>
    <a href="/posts/">Yazılar</a>
    <a href="/about/">Hakkında</a>
    <a href="/contact/">İletişim</a>
    <a href="/rss.xml">RSS</a>
  </div>
</footer>

<style>
  .site-footer {
    @apply w-full bg-skin-card;
  }
  .footer-inner {
    @apply mx-auto flex max-w-3xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-6 text-sm text-skin-base/70;
  }
  .footer-inner a {
    @apply text-skin-base/70 transition-colors hover:text-skin-base;
  }
  .spacer {
    @apply hidden flex-1 sm:block;
  }
</style>

---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li class={`inline-block ${size === "sm" ? "my-1" : "my-1 mx-0.5"}`}>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class={`chip ${size === "sm" ? "text-xs" : "text-sm"}`}
  >
    {tag}
  </a>
</li>

<style>
  .chip {
    @apply inline-block rounded-full border border-skin-line bg-skin-card-muted px-3 py-1.5 font-medium text-skin-base/70 no-underline transition-colors hover:border-skin-fill/40 hover:text-skin-base;
  }
</style>

---
import { LOGO_IMAGE, SITE } from "@config";
import LinkButton from "./LinkButton.astro";

export interface Props {
  activeNav?: "posts" | "tags" | "about" | "contact" | "search";
}

const { activeNav } = Astro.props;

const PALETTES = [
  { id: "kum", label: "Kum", swatch: "#a4381c" },
  { id: "mavi", label: "Mavi", swatch: "#2f5bd0" },
  { id: "yesil", label: "Yeşil", swatch: "#2f6b46" },
  { id: "gri", label: "Gri", swatch: "#131313" },
];
---

<header class="site-header">
  <a id="skip-to-content" href="#main-content">Skip to content</a>
  <div class="header-inner">
    <a href="/" class="logo whitespace-nowrap">
      {
        LOGO_IMAGE.enable ? (
          <img
            src={`/assets/${LOGO_IMAGE.svg ? "logo.svg" : "logo.png"}`}
            alt={SITE.title}
            width={LOGO_IMAGE.width}
            height={LOGO_IMAGE.height}
          />
        ) : (
          SITE.title
        )
      }
    </a>

    <nav class="site-nav" aria-label="Ana menü">
      <a href="/posts/" class={activeNav === "posts" ? "active" : ""}>Yazılar</a
      >
      <a href="/tags/" class={activeNav === "tags" ? "active" : ""}>Etiketler</a
      >
      <a href="/about/" class={activeNav === "about" ? "active" : ""}
        >Hakkında</a
      >
      <a href="/contact/" class={activeNav === "contact" ? "active" : ""}
        >İletişim</a
      >
    </nav>

    <div class="spacer"></div>

    <LinkButton
      href="/search/"
      className={`icon-btn focus-outline ${activeNav === "search" ? "active" : ""}`}
      ariaLabel="search"
      title="Ara"
    >
      <svg xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M19.023 16.977a35.13 35.13 0 0 1-1.367-1.384c-.372-.378-.596-.653-.596-.653l-2.8-1.337A6.962 6.962 0 0 0 16 9c0-3.859-3.14-7-7-7S2 5.141 2 9s3.14 7 7 7c1.763 0 3.37-.66 4.603-1.739l1.337 2.8s.275.224.653.596c.387.363.896.854 1.384 1.367l1.358 1.392.604.646 2.121-2.121-.646-.604c-.379-.372-.885-.866-1.391-1.36zM9 14c-2.757 0-5-2.243-5-5s2.243-5 5-5 5 2.243 5 5-2.243 5-5 5z"
        ></path>
      </svg>
      <span class="sr-only">Ara</span>
    </LinkButton>

    <div class="palette-switcher" role="group" aria-label="Renk teması">
      {
        PALETTES.map(p => (
          <button
            type="button"
            data-palette-btn={p.id}
            class="palette-dot"
            style={`--swatch:${p.swatch}`}
            title={p.label}
            aria-label={p.label}
          />
        ))
      }
    </div>

    {
      SITE.lightAndDarkMode && (
        <button
          id="theme-btn"
          class="icon-btn focus-outline"
          title="Aydınlık / karanlık"
          aria-label="auto"
          aria-live="polite"
        >
          <svg xmlns="http://www.w3.org/2000/svg" id="moon-svg">
            <path d="M20.742 13.045a8.088 8.088 0 0 1-2.077.271c-2.135 0-4.14-.83-5.646-2.336a8.025 8.025 0 0 1-2.064-7.723A1 1 0 0 0 9.73 2.034a10.014 10.014 0 0 0-4.489 2.582c-3.898 3.898-3.898 10.243 0 14.143a9.937 9.937 0 0 0 7.072 2.93 9.93 9.93 0 0 0 7.07-2.929 10.007 10.007 0 0 0 2.583-4.491 1.001 1.001 0 0 0-1.224-1.224zm-2.772 4.301a7.947 7.947 0 0 1-5.656 2.343 7.953 7.953 0 0 1-5.658-2.344c-3.118-3.119-3.118-8.195 0-11.314a7.923 7.923 0 0 1 2.06-1.483 10.027 10.027 0 0 0 2.89 7.848 9.972 9.972 0 0 0 7.848 2.891 8.036 8.036 0 0 1-1.484 2.059z" />
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" id="sun-svg">
            <path d="M6.993 12c0 2.761 2.246 5.007 5.007 5.007s5.007-2.246 5.007-5.007S14.761 6.993 12 6.993 6.993 9.239 6.993 12zM12 8.993c1.658 0 3.007 1.349 3.007 3.007S13.658 15.007 12 15.007 8.993 13.658 8.993 12 10.342 8.993 12 8.993zM10.998 19h2v3h-2zm0-17h2v3h-2zm-9 9h3v2h-3zm17 0h3v2h-3zM4.219 18.363l2.12-2.122 1.415 1.414-2.12 2.122zM16.24 6.344l2.122-2.122 1.414 1.414-2.122 2.122zM6.342 7.759 4.22 5.637l1.415-1.414 2.12 2.122zm13.434 10.605-1.414 1.414-2.122-2.122 1.414-1.414z" />
          </svg>
        </button>
      )
    }
  </div>
</header>

<style>
  .site-header {
    @apply sticky top-0 z-40 border-b border-skin-line bg-skin-fill/90 backdrop-blur;
  }
  #skip-to-content {
    @apply absolute -top-full left-16 z-50 bg-skin-accent px-3 py-2 text-skin-inverted transition-all focus:top-4;
  }
  .header-inner {
    @apply mx-auto flex max-w-3xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-4;
  }
  .logo {
    @apply font-display text-xl tracking-tight text-skin-base;
  }
  .site-nav {
    @apply flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium;
  }
  .site-nav a {
    @apply text-skin-base/70 transition-colors hover:text-skin-base;
  }
  .site-nav a.active {
    @apply text-skin-accent;
  }
  .spacer {
    @apply hidden flex-1 sm:block;
  }
  .icon-btn {
    @apply flex h-9 w-9 items-center justify-center rounded-full border border-skin-line bg-skin-card text-skin-base/70 transition-colors hover:border-skin-fill/40 hover:text-skin-base;
  }
  .icon-btn svg {
    @apply h-4 w-4 fill-current;
  }
  .icon-btn.active {
    @apply border-skin-accent text-skin-accent;
  }
  #moon-svg,
  html[data-theme="dark"] #sun-svg {
    display: none;
  }
  #sun-svg,
  html[data-theme="dark"] #moon-svg {
    display: block;
  }
  .palette-switcher {
    @apply flex items-center gap-2;
  }
  .palette-dot {
    @apply h-4 w-4 cursor-pointer rounded-full border border-skin-line p-0 outline outline-2 outline-offset-2 outline-transparent;
    background: var(--swatch);
  }
  .palette-dot[aria-pressed="true"] {
    @apply outline-skin-fill;
  }
</style>

---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE, SOCIALS } from "@config";

const mail = SOCIALS.find(s => s.name === "Mail" && s.active);
const links = [
  ...(mail
    ? [
        {
          label: "E-posta",
          value: mail.href.replace("mailto:", ""),
          href: mail.href,
        },
      ]
    : []),
  { label: "RSS", value: "/rss.xml", href: "/rss.xml" },
  ...SOCIALS.filter(s => s.active && s.name !== "Mail").map(s => ({
    label: s.name,
    value: s.href.replace(/^https?:\/\//, ""),
    href: s.href,
  })),
];
---

<Layout title={`İletişim | ${SITE.title}`}>
  <Header activeNav="contact" />
  <main id="main-content">
    <div class="contact-grid">
      <div class="contact-intro">
        <h1>İletişim</h1>
        <p class="lede">
          Bir yazıya itiraz, bir soru ya da beraber çalışma teklifi — hepsi
          olur. Genelde birkaç gün içinde dönüyorum.
        </p>
        <div class="link-list">
          {
            links.map(l => (
              <a href={l.href} class="link-row">
                <span>{l.label}</span>
                <span class="muted">{l.value}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="contact-form-wrap">
        <p class="form-title">Mesaj bırak</p>
        <form class="contact-form" action={mail?.href} method="get">
          <input type="text" name="name" placeholder="Adın" required />
          <input type="email" name="email" placeholder="E-posta" required />
          <textarea name="body" rows="5" placeholder="Mesajın" required
          ></textarea>
          <button type="submit">Gönder</button>
          <p class="disclaimer">
            Gönder'e bastığında varsayılan e-posta uygulaman açılır.
          </p>
        </form>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-3xl px-4 pb-16 pt-10 sm:pt-16;
  }
  .contact-grid {
    @apply flex flex-wrap items-start gap-14;
  }
  .contact-intro {
    @apply min-w-[280px] flex-1;
  }
  .contact-intro h1 {
    @apply mb-5 text-4xl leading-tight tracking-tight sm:text-5xl;
  }
  .lede {
    @apply mb-8 max-w-md leading-relaxed text-skin-base/70;
  }
  .link-list {
    @apply flex flex-col;
  }
  .link-row {
    @apply flex items-center justify-between gap-4 border-t border-skin-line py-4 text-skin-base transition-colors hover:text-skin-accent hover:no-underline;
  }
  .link-row .muted {
    @apply text-sm text-skin-base/60;
  }

  .contact-form-wrap {
    @apply min-w-[280px] flex-1 rounded-2xl border border-skin-line bg-skin-card p-7;
  }
  .form-title {
    @apply mb-5 font-display text-xl;
  }
  .contact-form {
    @apply flex flex-col gap-3.5;
  }
  .contact-form input,
  .contact-form textarea {
    @apply w-full resize-y rounded-lg border border-skin-line bg-skin-fill px-3.5 py-3 text-sm text-skin-base outline-none;
  }
  .contact-form button {
    @apply rounded-lg border border-skin-accent bg-skin-accent px-5 py-3 text-sm font-semibold text-skin-inverted;
  }
  .disclaimer {
    @apply text-xs text-skin-base/60;
  }
</style>

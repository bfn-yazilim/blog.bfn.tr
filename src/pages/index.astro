---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Card from "@components/Card";
import getSortedPosts from "@utils/getSortedPosts";
import getUniqueTags from "@utils/getUniqueTags";
import { SITE } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const featured = featuredPosts[0] ?? sortedPosts[0];
const rest = featured
  ? sortedPosts.filter(p => p.slug !== featured.slug).slice(0, 6)
  : recentPosts.slice(0, 6);

const tags = getUniqueTags(posts);
---

<Layout>
  <Header activeNav="posts" />
  <main id="main-content">
    <section id="hero">
      <p class="eyebrow">Yazılım · {SITE.author}</p>
      <h1>{SITE.title}</h1>
      <p class="lede">{SITE.desc}</p>
    </section>

    <div class="tag-row">
      <LinkButton href="/tags/" className="tag-pill tag-pill--all">
        Tümü
      </LinkButton>
      {
        tags.map(({ tag, tagName }) => (
          <LinkButton href={`/tags/${tag}/`} className="tag-pill">
            {tagName}
          </LinkButton>
        ))
      }
      <span class="count-label">{sortedPosts.length} yazı</span>
    </div>

    {
      featured && (
        <article class="featured-post">
          <div class="meta-row">
            <span class="eyebrow-accent">Öne çıkan</span>
            <span class="dash" />
            <span class="muted">{featured.data.tags[0]}</span>
          </div>
          <h2>
            <a href={`/posts/${featured.slug}/`}>{featured.data.title}</a>
          </h2>
          <p class="dek">{featured.data.description}</p>
        </article>
      )
    }

    <ul class="post-list">
      {
        rest.map(({ data, slug }) => (
          <Card
            href={`/posts/${slug}/`}
            frontmatter={data}
            secHeading={false}
          />
        ))
      }
    </ul>

    <section class="newsletter">
      <div>
        <h4>Yeni yazılar e-postana gelsin</h4>
        <p>Ayda bir özet. Reklam yok, takip kodu yok, tek tıkla çıkış.</p>
      </div>
      <form class="newsletter-form">
        <input type="email" placeholder="ad@eposta.com" aria-label="E-posta" />
        <button type="submit">Kaydol</button>
      </form>
    </section>

    <div class="all-posts-btn-wrapper">
      <LinkButton href="/posts/">
        Tüm yazılar
        <svg xmlns="http://www.w3.org/2000/svg"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-3xl px-4 pb-16 pt-10 sm:pt-16;
  }

  /* ===== Hero ===== */
  #hero {
    @apply max-w-xl pb-10;
  }
  .eyebrow {
    @apply mb-3 text-xs font-semibold uppercase tracking-widest text-skin-accent;
  }
  #hero h1 {
    @apply mb-3 text-4xl leading-tight tracking-tight sm:text-5xl;
  }
  .lede {
    @apply text-lg leading-relaxed text-skin-base/70;
  }

  /* ===== Tag row ===== */
  .tag-row {
    @apply mb-10 flex flex-wrap items-center gap-2 border-b border-skin-line pb-7;
  }
  .tag-row :global(.tag-pill) {
    @apply rounded-full border border-skin-line bg-skin-card-muted px-4 py-1.5 text-sm font-medium text-skin-base/70 transition-colors hover:border-skin-fill/40 hover:text-skin-base;
  }
  .tag-row :global(.tag-pill--all) {
    @apply border-skin-fill bg-skin-inverted text-skin-inverted;
  }
  .count-label {
    @apply ml-auto text-sm text-skin-base/60;
  }

  /* ===== Featured post ===== */
  .featured-post {
    @apply mb-12;
  }
  .meta-row {
    @apply mb-3 flex items-center gap-3 text-xs;
  }
  .meta-row .eyebrow-accent {
    @apply font-semibold uppercase tracking-widest text-skin-accent;
  }
  .meta-row .dash {
    @apply h-px w-4 bg-skin-line;
  }
  .meta-row .muted {
    @apply text-skin-base/60;
  }
  .featured-post h2 {
    @apply mb-3 max-w-2xl text-3xl leading-tight tracking-tight sm:text-4xl;
  }
  .featured-post h2 a {
    @apply text-skin-base hover:text-skin-accent;
  }
  .featured-post .dek {
    @apply max-w-xl text-base leading-relaxed text-skin-base/70;
  }

  /* ===== Post list ===== */
  .post-list {
    @apply flex flex-col;
  }

  /* ===== Newsletter ===== */
  .newsletter {
    @apply mt-16 flex flex-wrap items-center gap-8 rounded-2xl border border-skin-line bg-skin-card p-9;
  }
  .newsletter > div {
    @apply flex-1;
  }
  .newsletter h4 {
    @apply mb-2 text-xl;
  }
  .newsletter p {
    @apply text-sm text-skin-base/70;
  }
  .newsletter-form {
    @apply flex flex-wrap gap-2.5;
  }
  .newsletter-form input {
    @apply w-56 rounded-lg border border-skin-line bg-skin-fill px-4 py-3 text-sm text-skin-base outline-none;
  }
  .newsletter-form button {
    @apply rounded-lg border border-skin-accent bg-skin-accent px-5 py-3 text-sm font-semibold text-skin-inverted;
  }

  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }
</style>
